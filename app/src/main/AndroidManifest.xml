<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        도로록(DOROROK) — 모든 키 입력과 이미지 처리는 단말기 안에서만 이루어진다.
        INTERNET 권한을 의도적으로 선언하지 않는다 (누끼/스티커 파이프라인은 100% 로컬).
        광고·결제 SDK 도입 시점(4주차)에만 해당 SDK 가 요구하는 권한을 추가한다.
    -->

    <application
        android:name=".DororokApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher_dororok"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dororok">

        <!-- 스티커 스튜디오(본체 앱) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Dororok"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 홈 화면·설정에서 "키보드 변경" 진입 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/ime" />
            </intent-filter>
        </activity>

        <!-- 기본 키보드(IME) 서비스 -->
        <service
            android:name=".ime.DororokImeService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- CommitContent 전송용 FileProvider — stickers/ 디렉토리만 노출 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.stickerfileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
